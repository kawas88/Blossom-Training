NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_JWT_SECRET=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — required for billing in Phase 2.
# Get keys at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret. In dev, run `stripe listen --forward-to localhost:3000/api/billing/webhook`
# and copy the `whsec_...` it prints. In production, create a webhook endpoint in the
# Stripe Dashboard pointing at /api/billing/webhook and copy the secret from there.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs. Run `npm run setup:stripe` once after adding keys above — it creates
# the products and prices in your Stripe account and prints these IDs ready to paste.
STRIPE_PRICE_PERSONAL_MONTHLY_AED=price_...
STRIPE_PRICE_PERSONAL_ANNUAL_AED=price_...
STRIPE_PRICE_PERSONAL_MONTHLY_USD=price_...
STRIPE_PRICE_PERSONAL_ANNUAL_USD=price_...
STRIPE_PRICE_ORG_MONTHLY_AED=price_...
STRIPE_PRICE_ORG_ANNUAL_AED=price_...
STRIPE_PRICE_ORG_MONTHLY_USD=price_...
STRIPE_PRICE_ORG_ANNUAL_USD=price_...
